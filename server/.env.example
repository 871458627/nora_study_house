# 小桃学习屋 server 环境变量样例（复制为 .env 后填写；.env 不入 git——见 docs/03 §8.4 红线 1）

# JWT 签名密钥：≥32 字节随机串（例：openssl rand -hex 48）。生产必填；
# 本地缺省时使用开发默认值并打印 warn（绝不可用于生产）
JWT_SECRET=

# access token 有效期（秒），默认 7200（2 小时）
ACCESS_TOKEN_TTL=7200

# refresh token 有效期（秒），默认 2592000（30 天）
REFRESH_TOKEN_TTL=2592000

# PostgreSQL 连接串（docker compose 内网，如 postgresql://xiaotao:pass@postgres:5432/xiaotao）
# 为空时 dev 启动退化为内存仓储（数据不持久，仅限本地联调）
DATABASE_URL=

# HTTP 监听
PORT=3000
HOST=0.0.0.0

# refresh cookie 的 Secure 属性；本地 http 联调可临时设 false（生产必须 true）
COOKIE_SECURE=true

# pino 日志级别
LOG_LEVEL=info

# 部署版本标识（健康检查展示；容器入口注入 git sha）
APP_VERSION=dev
