# 复制为 .env 并逐项填写（bash gen-secrets.sh 可一键生成强随机值）
# ===== 域名与证书 =====
DOMAIN=study.example.com
ACME_EMAIL=you@example.com

# ===== 数据库（gen-secrets.sh 生成）=====
POSTGRES_USER=xiaotao
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=xiaotao
# 容器内网地址：主机固定为 db，端口 5432
DATABASE_URL=postgresql://xiaotao:CHANGE_ME@db:5432/xiaotao?schema=public

# ===== 应用（gen-secrets.sh 生成）=====
# >=32 字节随机串；轮换会使全部登录失效，需提前通知家人
JWT_SECRET=CHANGE_ME
XTAO_REPO=prisma

# ===== 可调（默认即可）=====
# ACCESS_TOKEN_TTL=7200
# REFRESH_TOKEN_TTL=2592000
# COOKIE_SECURE=true
# LOG_LEVEL=info
